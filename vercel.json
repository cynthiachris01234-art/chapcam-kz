{
  "framework": "nextjs",
  "regions": [
    "cdg1"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.chapcam.com"
        }
      ],
      "destination": "https://chapcam.com/:path*",
      "permanent": true
    }
  ]
}
